# HopTrace CMake helpers. Available after add_subdirectory(hoptrace), FetchContent, or find_package(HopTrace).

# Compile `tgt` with per-function enter/exit hooks.
# GCC skips std headers via an exclude list; Clang has none, so it uses after-inlining (inlined std helpers vanish, out-of-line templates still show).
function(hoptrace_instrument tgt)
  if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
    target_compile_options(${tgt} PRIVATE -finstrument-functions-after-inlining)  # skips inlined std helpers
  else()
    target_compile_options(${tgt} PRIVATE -finstrument-functions)
  endif()
  if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    target_compile_options(${tgt} PRIVATE -finstrument-functions-exclude-file-list=/usr/include,/usr/lib)
  endif()
endfunction()

# hoptrace_add_benchmark(<name>
#     TARGETS    <files with HT_TARGET(...)>   # .cpp files are compiled; headers are #included into a generated .cpp
#     [LINK       <libraries>]                 # your code the targets call
#     [INSTRUMENT <targets>])                  # libraries to compile with hop hooks (usually the same as LINK)
# Builds an executable <name> whose main() is HopTrace's runner; run `<name> --help`.
function(hoptrace_add_benchmark name)
  cmake_parse_arguments(HT "" "" "TARGETS;LINK;INSTRUMENT" ${ARGN})
  if(NOT HT_TARGETS)
    message(FATAL_ERROR "hoptrace_add_benchmark(${name}): TARGETS <files with HT_TARGET> is required")
  endif()
  set(gen "${CMAKE_CURRENT_BINARY_DIR}/${name}_hoptrace.cpp")
  set(srcs "${gen}")
  set(body "// generated by hoptrace_add_benchmark(${name})\n")
  foreach(f IN LISTS HT_TARGETS)
    get_filename_component(abs "${f}" ABSOLUTE)
    if(abs MATCHES "\\.(h|hh|hpp|hxx)$")
      string(APPEND body "#include \"${abs}\"\n")
    else()
      list(APPEND srcs "${abs}")
    endif()
  endforeach()
  # run metadata: the git SHA of the project being benchmarked
  execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
                  OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  string(APPEND body "extern \"C\" const char* const ht_git_sha = \"${sha}\";\n")
  file(GENERATE OUTPUT "${gen}" CONTENT "${body}")
  add_executable(${name} ${srcs})
  target_link_libraries(${name} PRIVATE ${HT_LINK} HopTrace::hoptrace)
  foreach(t IN LISTS HT_INSTRUMENT)
    hoptrace_instrument(${t})
  endforeach()
endfunction()
